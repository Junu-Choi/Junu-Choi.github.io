---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionRule from "../components/SectionRule.astro";
import ResearchAreas from "../components/ResearchAreas.astro";
import PaperList from "../components/PaperList.astro";
import { papers } from "../data/papers";
import { site } from "../config/site";

const hasSelectedPapers = papers.some((p) => p.selected);
---
<BaseLayout activeNav="about">

  <header class="masthead">
    <h1>{site.name}</h1>
    <p class="role">Graduate student, Interdisciplinary Program in AI &middot; Seoul National University</p>
  </header>

  <section class="about">
    <p>I am a graduate student at the Interdisciplinary Program in AI at Seoul National University. I work on generative modeling through the lens of dynamics &mdash; <em>designing the processes that carry noise to data</em> (diffusion, flows, stochastic interpolants) and understanding them with the tools of <em>optimal transport</em>.</p>
    <p>I am drawn to the questions where the design space is geometric: which dynamics to run, along which path between distributions, at what cost &mdash; and what the answers reveal about the structure of high-dimensional data.</p>
  </section>

  <section>
    <SectionRule label="Research"/>
    <ResearchAreas/>
  </section>

  {hasSelectedPapers && (
    <section>
      <SectionRule label="Selected papers"/>
      <PaperList selectedOnly/>
    </section>
  )}

</BaseLayout>
