---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchMap from "../components/ResearchMap.astro";
import PaperList from "../components/PaperList.astro";
import "../styles/home.css";
import { papers } from "../data/papers";
import { astraPreview, ptmManuscript } from "../data/manuscripts";
import { site } from "../config/site";

const hasSelectedPapers = papers.some((p) => p.selected);
---
<BaseLayout activeNav="about" pageClass="home-page">
  <div class="container home-body">
    <header class="identity">
      <div class="identity-copy">
        <h1 id="hero-title">{site.name}</h1>
        <p class="identity-description">
          I am a Master’s student in Artificial Intelligence at <strong>Seoul National University</strong>, studying <strong>generative modeling</strong>, <strong>probabilistic inference</strong>, and <strong>scientific machine learning</strong>.
        </p>
        <p class="identity-description">
          Previously, I completed my B.S. in Computer Science and Mathematical Sciences at <strong>KAIST</strong>.
        </p>
        <div class="dm-meta-row hero-actions">
          <a class="dm-pill-btn" href="/papers/">Read papers</a>
          <a class="dm-meta-link" href={`mailto:${site.email}`}>{site.email} <span class="dm-chevron" aria-hidden="true">›</span></a>
          <a class="dm-meta-link" href="/cv/">Curriculum Vitae <span class="dm-chevron" aria-hidden="true">›</span></a>
          <a class="dm-meta-link" href="https://orcid.org/0009-0005-6979-9505">ORCID <span class="dm-chevron" aria-hidden="true">›</span></a>
        </div>
      </div>
      <div class="portrait-frame">
        <img class="identity-portrait" src="/junu.jpeg" alt="Portrait of Junu Choi" width="800" height="1103" loading="eager" fetchpriority="high"/>
      </div>
    </header>

    <ResearchMap/>

    <section class="home-publications" aria-labelledby="selected-title">
      <div class="dm-section-head">
        <div class="dm-section-titles">
          <h2 id="selected-title" class="dm-section-title">Papers</h2>
        </div>
        <a class="dm-pill-btn" href="/papers/">All papers</a>
      </div>

      <div class="paper-list">
        <article class="paper-row">
          <div class="paper-copy">
            <h3 class="paper-title">
              <a href={`/papers/#${astraPreview.id}`}>{astraPreview.title}</a>
            </h3>
            <p class="paper-authors"><strong>Junu Choi</strong>, Youngjoon Hong</p>
            <p class="paper-desc">
              Kantorovich Attention routes information from both sides (pull &amp; push) so zero regions are left unread, closely matching the exact optimal transport plan. Trained on a single 8-GPU node, Astra beats ECMWF IFS ENS across all 600 target–lead cells.
            </p>
            <div class="dm-meta-row">
              <span>2026</span>
              <span>arXiv:2610.35545</span>
              <a class="dm-meta-link" href={astraPreview.arxiv}>Read paper <span class="dm-chevron" aria-hidden="true">›</span></a>
              <a class="dm-meta-link" href={astraPreview.pdf}>PDF <span class="dm-chevron" aria-hidden="true">›</span></a>
              <a class="dm-meta-link" href="/papers/#ka-title">Interactive preview <span class="dm-chevron" aria-hidden="true">›</span></a>
            </div>
          </div>
          <figure class="paper-thumb-stage">
            <a href="/papers/#ka-title" aria-label="Open Astra Kantorovich Attention interactive preview">
              <img src="/figures/astra/hero-globe.webp" width="1039" height="1000" loading="eager" decoding="async" alt="Astra 3D cut-away Earth globe illustrating two-sided Kantorovich Attention transport tubes and raised tile zooms"/>
            </a>
          </figure>
        </article>

        <article class="paper-row">
          <div class="paper-copy">
            <h3 class="paper-title">
              <a href={ptmManuscript.href}>{ptmManuscript.title}</a>
            </h3>
            <p class="paper-desc">
              {ptmManuscript.description}
            </p>
            <div class="dm-meta-row">
              <span>2026</span>
              <span>{ptmManuscript.status}</span>
              <a class="dm-meta-link" href={ptmManuscript.href}>Overview <span class="dm-chevron" aria-hidden="true">›</span></a>
              <a class="dm-meta-link" href="/papers/#geometry-title">Interactive geometry <span class="dm-chevron" aria-hidden="true">›</span></a>
            </div>
          </div>
          <figure class="paper-thumb-stage">
            <a href={ptmManuscript.href} aria-label="Open Posterior Transport Matching preview">
              <img src="/figures/ptm/figure-2.svg" width="1875" height="734" loading="lazy" decoding="async" alt="Posterior Transport Matching Figure 2"/>
            </a>
          </figure>
        </article>
      </div>
      {hasSelectedPapers && <PaperList selectedOnly/>}
    </section>
  </div>
</BaseLayout>
