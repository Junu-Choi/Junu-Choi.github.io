---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionRule from "../components/SectionRule.astro";
import ResearchMap from "../components/ResearchMap.astro";
import PaperList from "../components/PaperList.astro";
import "../styles/home.css";
import { papers } from "../data/papers";

const hasSelectedPapers = papers.some((p) => p.selected);
const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latestNote = notes[0];
---
<BaseLayout activeNav="about" pageClass="home-page">
  <header class="identity">
    <div class="identity-copy">
      <h1 id="hero-title">Junu Choi</h1>
      <p class="identity-affiliation">Graduate researcher <span class="identity-separator" aria-hidden="true">·</span> <span class="identity-institution">Seoul National University</span></p>
      <p class="identity-description">I study generative modeling, probabilistic inference,<br class="identity-break"/> and scientific machine learning.</p>
    </div>
    <img class="identity-portrait" src="/junu.jpeg" alt="Portrait of Junu Choi" width="800" height="1103" loading="eager" fetchpriority="high"/>
  </header>

  <ResearchMap/>

  {latestNote && (
    <section class="home-note" aria-labelledby="writing-title">
      <div class="home-note-heading">
        <h2 id="writing-title"><a href="/notes/">Research notes</a></h2>
        <time datetime={latestNote.data.publishedAt.toISOString()}>{latestNote.data.publishedAt.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" })}</time>
      </div>
      <div class="home-note-copy">
        <h3><a href={`/notes/${latestNote.id}/`}>{latestNote.data.title} <span aria-hidden="true">↗</span></a></h3>
        <p>{latestNote.data.abstract}</p>
      </div>
    </section>
  )}

  {hasSelectedPapers && (
    <section class="home-publications" aria-labelledby="selected-title">
      <SectionRule label="Selected papers" id="selected-title" href="/papers/" linkLabel="All papers"/>
      <PaperList selectedOnly/>
    </section>
  )}
</BaseLayout>
