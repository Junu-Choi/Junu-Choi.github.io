---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionRule from "../components/SectionRule.astro";
import ResearchIndex from "../components/ResearchIndex.astro";
import PaperList from "../components/PaperList.astro";
import "../styles/home.css";
import { papers } from "../data/papers";

const hasSelectedPapers = papers.some((p) => p.selected);
const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latestNote = notes[0];
---
<BaseLayout activeNav="about" pageClass="home-page">
  <section class="identity" aria-labelledby="hero-title">
    <h1 class="identity-name" id="hero-title" aria-label="Junu Choi">
      <span>Junu</span>
      <img class="identity-portrait" src="/junu.jpeg" alt="" width="800" height="1103" loading="eager" fetchpriority="high"/>
      <span>Choi</span>
    </h1>
    <div class="identity-description">
      <p class="identity-affiliation">Graduate researcher<span>Seoul National University · IPAI</span></p>
      <p>I work on generative modeling, probabilistic inference, and scientific machine learning.</p>
    </div>
  </section>

  <ResearchIndex/>

  {hasSelectedPapers && (
    <section class="index-publications" aria-labelledby="selected-title">
      <SectionRule label="Selected papers" id="selected-title" href="/papers/" linkLabel="All papers"/>
      <PaperList selectedOnly/>
    </section>
  )}
  {latestNote && (
    <section class="index-note" aria-labelledby="writing-title">
      <h2 id="writing-title"><a href="/notes/">Research notes</a></h2>
      <div class="index-note-content">
        <h3><a href={`/notes/${latestNote.id}/`}>{latestNote.data.title} <span aria-hidden="true">↗</span></a></h3>
        <p>{latestNote.data.abstract}</p>
      </div>
      <time datetime={latestNote.data.publishedAt.toISOString()}>{latestNote.data.publishedAt.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" })}</time>
    </section>
  )}
</BaseLayout>
