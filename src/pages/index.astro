---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionRule from "../components/SectionRule.astro";
import ResearchAreas from "../components/ResearchAreas.astro";
import PaperList from "../components/PaperList.astro";
import { papers } from "../data/papers";
import { site } from "../config/site";

const hasSelectedPapers = papers.some((p) => p.selected);
const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const latestNote = notes[0];
---
<BaseLayout activeNav="about" pageClass="home-page">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Machine learning · Inference · Geometry</p>
      <h1 id="hero-title">Junu Choi<span class="name-period">.</span></h1>
      <p class="hero-statement">Learning and inference,<br/><span>grounded in structure.</span></p>
      <p class="hero-description">I study how mathematical structure can guide learning and inference. My current work centers on generative dynamics, posterior sampling, and scientific modeling, building on earlier work in speech, multimodal learning, and efficient adaptation.</p>
      <div class="hero-links">
        <a class="text-link" href="#research">Research interests <span aria-hidden="true">↓</span></a>
        <a class="text-link muted-link" href="/cv/">View CV <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="hero-portrait">
      <div class="portrait-frame"><img src="/junu.jpeg" alt={`Portrait of ${site.name}`} width="800" height="1103" loading="eager" fetchpriority="high"/></div>
      <figcaption>
        <p class="portrait-statement">From mathematical ideas<br/>to working systems.</p>
        <p class="portrait-affiliation"><strong>Graduate researcher · Seoul National University</strong><span>Interdisciplinary Program in Artificial Intelligence</span></p>
      </figcaption>
    </figure>
  </section>

  <section class="home-section" id="research" aria-labelledby="research-title">
    <SectionRule label="Research interests" index="01" id="research-title"/>
    <ResearchAreas/>
  </section>

  {hasSelectedPapers && (
    <section class="home-section" aria-labelledby="selected-title">
      <SectionRule label="Selected papers" id="selected-title" href="/papers/" linkLabel="All papers"/>
      <PaperList selectedOnly/>
    </section>
  )}
  {latestNote && (
    <section class="home-section" aria-labelledby="writing-title">
      <SectionRule label="From the notebook" index="02" id="writing-title" href="/notes/" linkLabel="All notes"/>
      <a class="featured-note" href={`/notes/${latestNote.id}/`}>
        <div class="featured-note-meta"><span class="eyebrow">Research note</span><time datetime={latestNote.data.publishedAt.toISOString()}>{latestNote.data.publishedAt.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" })}</time></div>
        <div class="featured-note-content"><h3>{latestNote.data.title}</h3><p>{latestNote.data.abstract}</p><ul class="notes-tags">{latestNote.data.tags.map((tag) => <li>{tag}</li>)}</ul></div>
        <span class="featured-note-arrow" aria-hidden="true">↗</span>
      </a>
    </section>
  )}
</BaseLayout>
