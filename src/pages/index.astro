---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionRule from "../components/SectionRule.astro";
import ResearchAreas from "../components/ResearchAreas.astro";
import PaperList from "../components/PaperList.astro";
import { papers } from "../data/papers";
import { site } from "../config/site";

const hasSelectedPapers = papers.some((p) => p.selected);
---
<BaseLayout activeNav="about">

  <header class="masthead">
    <h1>{site.name}</h1>
  </header>

  <section class="about">
    <p>I am a graduate student at the Interdisciplinary Program in AI at Seoul National University. My research sits at the intersection of <em>stochastic dynamics</em>, <em>deep geometric analysis</em>, and <em>generative modeling</em> &mdash; pursued both as mathematical objects in their own right and as foundations for designing learning systems that live in those settings.</p>
    <p>I am drawn to the way randomness and geometry organise high-dimensional dynamics, and to the questions this raises across analysis, probability, and modern machine learning &mdash; from the structure of SDEs and SPDEs to the design and analysis of generative models across families.</p>
  </section>

  <section>
    <SectionRule label="Research"/>
    <ResearchAreas/>
  </section>

  {hasSelectedPapers && (
    <section>
      <SectionRule label="Selected papers"/>
      <PaperList selectedOnly/>
    </section>
  )}

</BaseLayout>
