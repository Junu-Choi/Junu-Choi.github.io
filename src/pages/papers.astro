---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperList from "../components/PaperList.astro";
import { papers } from "../data/papers";
---
<BaseLayout title="Papers" activeNav="papers" pageClass="papers-page">

  <header class="page-head">
    <p class="eyebrow">Research / Papers</p>
    <h1>Publications<span class="name-period">.</span></h1>
    <p class="page-intro">Papers and preprints on generative modeling.</p>
  </header>

  {papers.length === 0 ? (
    <div class="empty-state">
      <span class="empty-mark" aria-hidden="true">↗</span>
      <div><h2>Work in progress.</h2><p>Preprints and publications will appear here as they are released.</p><a class="text-link" href="/notes/">Read my research notes <span aria-hidden="true">↗</span></a></div>
    </div>
  ) : (
    <PaperList/>
  )}

</BaseLayout>
