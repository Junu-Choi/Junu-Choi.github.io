---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperList from "../components/PaperList.astro";
import PublicationPreview from "../components/PublicationPreview.astro";
import { papers } from "../data/papers";
---
<BaseLayout title="Papers" activeNav="papers" pageClass="papers-page">

  <header class="page-head">
    <p class="eyebrow">Research / Papers</p>
    <h1>Publications<span class="name-period">.</span></h1>
    <p class="page-intro">Work on generative dynamics, inference, and geometry.</p>
  </header>

  <PublicationPreview/>
  {papers.length > 0 && <PaperList/>}

</BaseLayout>
