---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionRule from "../components/SectionRule.astro";
import CVEntries from "../components/CVEntries.astro";
import { cv, type CVEntry } from "../data/cv";
import { papers, type Paper } from "../data/papers";
import { site } from "../config/site";

/**
 * Render each paper as a CVEntry so the Publications section on /cv
 * shares typography with Education / Experience / Awards.
 *   - title:   paper title (placeholder while under review)
 *   - date:    year (right-aligned, mono)
 *   - place:   author list (the † notation is preserved verbatim)
 *   - details: venue line; link list if available
 * Data still lives in src/data/papers.ts — this is purely a view.
 */
function paperToCVEntry(p: Paper): CVEntry {
  // Compose the venue line as plain text so the CV's Publications section
  // stays visually aligned with Education / Experience / Awards.
  // Year already lives in the right-aligned date column, so the venue
  // line only carries the venue abbreviation + grade + status + note.
  const venueParts = [p.venue];
  if (p.grade)  venueParts.push(p.grade);
  if (p.status) venueParts.push(p.status);
  if (p.note)   venueParts.push(p.note);
  const details: string[] = [venueParts.join(" · ")];
  if (p.links && p.links.length > 0) {
    details.push(p.links.map((l) => l.label).join(" · "));
  }
  return {
    title: p.title,
    place: p.authors,
    date: String(p.year),
    details,
  };
}

const publicationEntries: CVEntry[] = papers
  .slice()
  .sort((a, b) => b.year - a.year)
  .map(paperToCVEntry);

/**
 * SHA-256 of the download passphrase. Default value here is the hash of
 * `junu-cv-private`. To change: pick a new passphrase and replace the
 * `expectedHash` value below with the output of
 *   echo -n "your-new-passphrase" | shasum -a 256 | head -c 64
 */
const expectedHash = "4e62b4fcd27edfdc23251df7002ed399eeb81bd64a6cb76829fc8913768082c3";
---
<BaseLayout title="CV" activeNav="cv">

  <header class="page-head">
    <h1>Curriculum Vitae</h1>
    <div class="cv-meta">
      <span class="cv-updated">Last updated &mdash; {cv.lastUpdated}</span>
      <button type="button" class="cv-download" data-action="download-cv">
        Download as PDF
      </button>
    </div>
  </header>

  {/* Print-only header — replaces the page-head when the user prints */}
  <div class="print-only print-header" aria-hidden="true">
    <h1 class="print-name">{site.name}</h1>
    <div class="print-contact">
      {site.email} &nbsp;·&nbsp; github.com/Junu-Choi &nbsp;·&nbsp; {site.url}
    </div>
  </div>

  <section>
    <SectionRule label="Education"/>
    <CVEntries items={cv.education}/>
  </section>

  {publicationEntries.length > 0 && (
    <section>
      <SectionRule label="Publications"/>
      <CVEntries items={publicationEntries}/>
    </section>
  )}

  <section>
    <SectionRule label="Experience"/>
    <CVEntries items={cv.experience}/>
  </section>

  <section>
    <SectionRule label="Honors &amp; awards"/>
    <CVEntries items={cv.awards}/>
  </section>

  {/*
    Download gate: SHA-256 of a passphrase is compared client-side.
    Not cryptographically strong (anyone can dev-tools the hash and brute-force
    a weak passphrase) — but adequate for "casual visitors can't grab the
    button-driven PDF; only people who know the passphrase can".
  */}
  <script is:inline define:vars={{ expectedHash }}>
    document
      .querySelector('[data-action="download-cv"]')
      ?.addEventListener('click', async () => {
        const pwd = window.prompt('Passphrase:');
        if (!pwd) return;
        const buf = await crypto.subtle.digest(
          'SHA-256',
          new TextEncoder().encode(pwd)
        );
        const hash = Array.from(new Uint8Array(buf))
          .map((b) => b.toString(16).padStart(2, '0'))
          .join('');
        if (hash !== expectedHash) {
          window.alert('Incorrect passphrase.');
          return;
        }
        /* Clear document title so the browser's default print header
           does not embed "CV — Junu Choi" alongside the auto-timestamp.
           To remove the timestamp itself the user must uncheck
           "Headers and footers" in the print dialog (one-time setting). */
        const origTitle = document.title;
        document.title = '';
        setTimeout(() => { document.title = origTitle; }, 1500);
        window.print();
      });
  </script>

</BaseLayout>
