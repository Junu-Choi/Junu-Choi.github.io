---
import { getCollection } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const notes = allNotes.sort((a, b) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
---
<BaseLayout title="Notes" activeNav="notes" pageClass="notes-page">

  <header class="page-head">
    <p class="eyebrow">Ideas / Notebook</p>
    <h1>Research notes<span class="name-period">.</span></h1>
    <p class="page-intro">One question. One useful result.</p>
  </header>

  {notes.length === 0 ? (
    <p class="note">
      <em>Coming soon.</em> Informal notes on stochastic analysis, geometry, and generative models will be posted here.
    </p>
  ) : (
    <ul class="notes-list">
      {notes.map((n) => (
        <li class="notes-entry">
          <time class="notes-date" datetime={n.data.publishedAt.toISOString()}>
            {n.data.publishedAt.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" })}
          </time>
          <div class="notes-summary">
          <h2><a href={`/notes/${n.id}/`} class="notes-title">{n.data.title}<span aria-hidden="true">↗</span></a></h2>
          <p class="notes-abstract">{n.data.abstract}</p>
          {n.data.tags.length > 0 && (
            <ul class="notes-tags">
              {n.data.tags.map((t) => <li>{t}</li>)}
            </ul>
          )}
          </div>
        </li>
      ))}
    </ul>
  )}

</BaseLayout>
