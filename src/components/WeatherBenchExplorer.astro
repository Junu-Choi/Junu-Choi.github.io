---
import wb2Data from "../../public/figures/astra/wb2-025.json";

interface Props {
  id?: string;
  compact?: boolean;
}

const { id = "wb2-explorer", compact = false } = Astro.props;

// Pre-compute initial SVG geometry for Z500 crpsAbs (default 1st tab: CRPS) for instant 0-CLS SSR paint.
const initVar = wb2Data.variables[0];
const initSeries = initVar.crpsAbs;
const W = 640;
const H = 264;
const PAD = { l: 48, r: 16, t: 14, b: 34 };
const plotW = W - PAD.l - PAD.r;
const plotH = H - PAD.t - PAD.b;

const allVals: number[] = [0];
for (const k of ["Astra vs ERA5", "GenCast vs ERA5", "GenCast (oper.) vs ERA5", "IFS ENS vs ERA5"]) {
  const pts = (initSeries as Record<string, number[][]>)[k] ?? [];
  for (const p of pts) allVals.push(p[1]);
}
const yMin = 0;
const yMax = 360;

const xToPx = (h: number) => PAD.l + ((h - 12) / (360 - 12)) * plotW;
const yToPx = (v: number) => PAD.t + ((yMax - v) / (yMax - yMin)) * plotH;

function buildPath(pts: number[][]): string {
  if (!pts || pts.length === 0) return "";
  return pts
    .map((p, idx) => `${idx === 0 ? "M" : "L"}${xToPx(p[0]).toFixed(1)},${yToPx(p[1]).toFixed(1)}`)
    .join(" ");
}

const yTicks = [0, 100, 200, 300];
const xDayTicks = [1, 3, 5, 7, 10, 12, 15];
const tableHours = [24, 72, 120, 240, 360];

function valAt(pts: number[][] | undefined, h: number): number | null {
  if (!pts) return null;
  const found = pts.find((p) => p[0] === h);
  return found ? found[1] : null;
}

function fmtAbsInit(v: number | null): string {
  if (v === null) return "—";
  return v.toFixed(1);
}
---

<section
  class:list={["wb2-explorer", compact && "wb2-explorer--compact"]}
  id={id}
  data-wb2-explorer
  aria-label="Official WeatherBench 2 quarter-degree benchmark explorer"
>
  <div class="wb2-top">
    <div class="wb2-intro">
      <div class="wb2-eyebrow-row">
        <span class="wb2-badge">
          <span class="wb2-dot" aria-hidden="true"></span>
          WeatherBench 2 · Official 0.25° (1440×721)
        </span>
        <span class="wb2-subbadge">2020 Global · Verified vs. ERA5</span>
      </div>
      <h4 class="wb2-title">Quarter-degree probabilistic ensemble benchmark</h4>
      <p class="wb2-subtitle">
        Among ERA5-initialized ensemble models evaluated at native <strong>0.25° (1440×721)</strong> resolution on WeatherBench 2, <strong>Astra</strong> (Seoul National University) and <strong>GenCast</strong> (Google DeepMind) are the only two ML models alongside ECMWF’s operational physical ensemble (<strong>IFS ENS</strong>).
      </p>
    </div>

    <div class="wb2-ext-links" aria-label="Official Google Research WeatherBench 2 pages">
      <a class="wb2-ext-btn" href={wb2Data.urls.leaderboard} target="_blank" rel="noopener noreferrer">
        WB2 Models <span aria-hidden="true">↗</span>
      </a>
      <a class="wb2-ext-btn" href={wb2Data.urls.scorecards} target="_blank" rel="noopener noreferrer">
        2020 Scorecards <span aria-hidden="true">↗</span>
      </a>
      <a
        class="wb2-ext-btn wb2-ext-btn--primary"
        href={wb2Data.urls.probabilistic}
        target="_blank"
        rel="noopener noreferrer"
        title="On WeatherBench 2 Probabilistic Scores, select Year: 2020 and Resolution: 1440x721"
      >
        Live WB2 Explorer <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div class="wb2-controls">
    <div class="wb2-var-pills" role="tablist" aria-label="Atmospheric variable">
      {wb2Data.variables.map((v, idx) => (
        <button
          type="button"
          role="tab"
          class:list={["wb2-var-pill", idx === 0 && "is-active"]}
          aria-selected={idx === 0 ? "true" : "false"}
          data-wb2-var={v.id}
        >
          {v.short}
        </button>
      ))}
    </div>

    <div class="wb2-metric-switch" role="group" aria-label="Evaluation metric">
      <button type="button" class="wb2-metric-btn is-active" data-wb2-metric="crpsAbs">
        CRPS
      </button>
      <button type="button" class="wb2-metric-btn" data-wb2-metric="rmseAbs">
        Ens. RMSE
      </button>
      <button type="button" class="wb2-metric-btn" data-wb2-metric="crpsRel">
        CRPS vs. IFS (%)
      </button>
      <button type="button" class="wb2-metric-btn" data-wb2-metric="rmseRel">
        RMSE vs. IFS (%)
      </button>
    </div>
  </div>

  <div class="wb2-body">
    <div class="wb2-chart-card">
      <div class="wb2-chart-head">
        <div class="wb2-chart-meta">
          <strong class="wb2-chart-varname" data-wb2-varname>{initVar.label}</strong>
          <span class="wb2-chart-metriclabel" data-wb2-metriclabel>
            Ensemble CRPS ({initVar.unit}) · Lower is better ↓
          </span>
        </div>
        <div class="wb2-legend" aria-hidden="true">
          <span class="wb2-leg-item wb2-leg-item--astra"><i></i>Astra</span>
          <span class="wb2-leg-item wb2-leg-item--gencast"><i></i>GenCast</span>
          <span class="wb2-leg-item wb2-leg-item--oper"><i></i>GenCast (oper.)</span>
          <span class="wb2-leg-item wb2-leg-item--ifs"><i></i>IFS ENS</span>
        </div>
      </div>

      <div class="wb2-svg-wrap" data-wb2-svg-wrap>
        <svg
          class="wb2-svg"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label="Lead-time performance curves at 0.25 degrees on WeatherBench 2 comparing Astra, GenCast, and ECMWF IFS ENS from 12 hours to 15 days."
          data-wb2-svg
        >
          <g data-wb2-grid>
            {yTicks.map((t) => {
              const py = yToPx(t);
              return (
                <g>
                  <line
                    x1={PAD.l}
                    x2={W - PAD.r}
                    y1={py}
                    y2={py}
                    stroke="rgba(255,255,255,0.08)"
                    stroke-width="1"
                  />
                  <text
                    x={PAD.l - 8}
                    y={py + 3.5}
                    text-anchor="end"
                    class="wb2-axis-txt"
                  >
                    {t}
                  </text>
                </g>
              );
            })}
            {xDayTicks.map((d) => {
              const px = xToPx(d * 24);
              return (
                <g>
                  <line x1={px} x2={px} y1={PAD.t} y2={H - PAD.b} stroke="rgba(255,255,255,0.045)" stroke-width="1" />
                  <text x={px} y={H - PAD.b + 16} text-anchor="middle" class="wb2-axis-txt">
                    {d}d
                  </text>
                </g>
              );
            })}
            <text x={PAD.l + plotW / 2} y={H - 4} text-anchor="middle" class="wb2-axis-caption">
              Forecast lead time (days)
            </text>
          </g>

          <g data-wb2-lines>
            <path
              d={buildPath(initSeries["IFS ENS vs ERA5"])}
              fill="none"
              stroke="#9aa0a6"
              stroke-width="1.5"
              stroke-dasharray="4 3"
            />
            <path
              d={buildPath(initSeries["GenCast (oper.) vs ERA5"])}
              fill="none"
              stroke="#fdd663"
              stroke-width="1.6"
              stroke-dasharray="2.5 2.5"
              opacity="0.85"
            />
            <path
              d={buildPath(initSeries["GenCast vs ERA5"])}
              fill="none"
              stroke="#f28b82"
              stroke-width="2.1"
            />
            <path
              d={buildPath(initSeries["Astra vs ERA5"])}
              fill="none"
              stroke="#8ab4f8"
              stroke-width="2.8"
            />
          </g>

          <g data-wb2-hover hidden>
            <line data-wb2-hover-line x1="0" x2="0" y1={PAD.t} y2={H - PAD.b} stroke="rgba(255,255,255,0.28)" stroke-width="1.2" />
            <g data-wb2-hover-dots></g>
          </g>
        </svg>

        <div class="wb2-tooltip" data-wb2-tooltip hidden></div>
      </div>
    </div>

    <div class="wb2-side">
      <div class="wb2-registry-card">
        <div class="wb2-side-head">
          <span class="wb2-side-title">0.25° ERA5 Ensemble Models</span>
          <span class="wb2-only-pill">Only 2 on WB2</span>
        </div>
        <ul class="wb2-model-list">
          <li class="wb2-model-item wb2-model-item--ours">
            <div class="wb2-model-main">
              <span class="wb2-swatch wb2-swatch--astra" aria-hidden="true"></span>
              <div>
                <div class="wb2-model-name">Astra <span class="wb2-org">· Seoul National Univ.</span></div>
                <div class="wb2-model-spec">0.25° · 50 members · 1×8 GPUs (9.8% compute)</div>
              </div>
            </div>
          </li>
          <li class="wb2-model-item">
            <div class="wb2-model-main">
              <span class="wb2-swatch wb2-swatch--gencast" aria-hidden="true"></span>
              <div>
                <div class="wb2-model-name">GenCast <span class="wb2-org">· Google DeepMind</span></div>
                <div class="wb2-model-spec">0.25° · 50 members · Diffusion ensemble</div>
              </div>
            </div>
          </li>
          <li class="wb2-model-item wb2-model-item--ref">
            <div class="wb2-model-main">
              <span class="wb2-swatch wb2-swatch--ifs" aria-hidden="true"></span>
              <div>
                <div class="wb2-model-name">IFS ENS <span class="wb2-org">· ECMWF (Physics)</span></div>
                <div class="wb2-model-spec">Operational NWP 50-member baseline</div>
              </div>
            </div>
          </li>
        </ul>
      </div>

      <div class="wb2-table-card">
        <div class="wb2-side-head">
          <span class="wb2-side-title" data-wb2-table-title>Z500 · CRPS</span>
          <span class="wb2-side-unit" data-wb2-table-unit>{initVar.unit}</span>
        </div>
        <table class="wb2-table">
          <thead>
            <tr>
              <th scope="col">Lead</th>
              <th scope="col" class="is-astra">Astra</th>
              <th scope="col">GenCast</th>
              <th scope="col" class="wb2-col-ifs" data-wb2-col-ifs>IFS ENS</th>
            </tr>
          </thead>
          <tbody data-wb2-tbody>
            {tableHours.map((h) => {
              const a = valAt(initSeries["Astra vs ERA5"], h);
              const g = valAt(initSeries["GenCast vs ERA5"], h);
              const ifs = valAt(initSeries["IFS ENS vs ERA5"], h);
              const aWins = a !== null && g !== null && a <= g + 1e-4;
              return (
                <tr>
                  <td>{h / 24}d</td>
                  <td class:list={["is-astra", aWins && "is-best"]}>{fmtAbsInit(a)}</td>
                  <td class:list={[!aWins && "is-best"]}>{fmtAbsInit(g)}</td>
                  <td>{fmtAbsInit(ifs)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <p class="wb2-footnote">
    Official <a href={wb2Data.urls.probabilistic} target="_blank" rel="noopener noreferrer">WeatherBench 2</a> global scores across all 2020 initialisations on the 1440×721 (0.25°) grid verified against ERA5. On Google’s interactive Probabilistic Explorer, set <strong>Year: 2020</strong> and <strong>Resolution: 1440x721</strong> to view the native quarter-degree curves.
  </p>
</section>

<script is:inline define:vars={{ wb2Data }}>
  (() => {
    const W = 640;
    const H = 264;
    const PAD = { l: 48, r: 16, t: 14, b: 34 };
    const plotW = W - PAD.l - PAD.r;
    const plotH = H - PAD.t - PAD.b;
    const xDayTicks = [1, 3, 5, 7, 10, 12, 15];
    const tableHours = [24, 72, 120, 240, 360];

    const METRIC_INFO = {
      crpsAbs: {
        short: "CRPS",
        label: (u) => `Ensemble CRPS (${u}) · Lower is better ↓`,
        unit: (u) => u,
        isRel: false,
        higherBetter: false,
      },
      rmseAbs: {
        short: "Ens. RMSE",
        label: (u) => `Ensemble-mean RMSE (${u}) · Lower is better ↓`,
        unit: (u) => u,
        isRel: false,
        higherBetter: false,
      },
      crpsRel: {
        short: "CRPS vs. IFS ENS",
        label: () => "CRPS skill vs. IFS ENS (%) · Higher is better ↑",
        unit: () => "% skill",
        isRel: true,
        higherBetter: true,
      },
      rmseRel: {
        short: "RMSE vs. IFS ENS",
        label: () => "Ensemble-mean RMSE skill vs. IFS ENS (%) · Higher is better ↑",
        unit: () => "% skill",
        isRel: true,
        higherBetter: true,
      },
    };

    const SERIES_STYLE = [
      { key: "IFS ENS vs ERA5", label: "IFS ENS", color: "#9aa0a6", width: 1.5, dash: "4 3" },
      { key: "GenCast (oper.) vs ERA5", label: "GenCast (oper.)", color: "#fdd663", width: 1.6, dash: "2.5 2.5" },
      { key: "GenCast vs ERA5", label: "GenCast", color: "#f28b82", width: 2.1, dash: "" },
      { key: "Astra vs ERA5", label: "Astra", color: "#8ab4f8", width: 2.8, dash: "" },
    ];

    function fmtVal(v, isRel, unit) {
      if (v === null || v === undefined || Number.isNaN(v)) return "—";
      if (isRel) return `${v > 0 ? "+" : ""}${v.toFixed(1)}%`;
      if (unit === "m²/s²" || unit === "Pa") return v.toFixed(1);
      return v.toFixed(2);
    }

    function niceTicks(minV, maxV, isRel) {
      const span = maxV - minV || 1;
      const rawStep = span / 4.5;
      const mag = Math.pow(10, Math.floor(Math.log10(rawStep)));
      const norm = rawStep / mag;
      const step = (norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10) * mag;
      const lo = isRel ? Math.min(0, Math.floor(minV / step) * step) : Math.max(0, Math.floor(minV / step) * step);
      const hi = Math.ceil(maxV / step) * step;
      const ticks = [];
      for (let t = lo; t <= hi + step * 0.001; t += step) {
        ticks.push(Number(t.toFixed(6)));
      }
      return { lo, hi: hi + step * 0.12, ticks, step };
    }

    document.querySelectorAll("[data-wb2-explorer]").forEach((root) => {
      if (root.dataset.wb2Init === "1") return;
      root.dataset.wb2Init = "1";

      let curVarId = wb2Data.variables[0].id;
      let curMetric = "crpsAbs";
      let currentScale = null;

      const varBtns = root.querySelectorAll("[data-wb2-var]");
      const metricBtns = root.querySelectorAll("[data-wb2-metric]");
      const varNameEl = root.querySelector("[data-wb2-varname]");
      const metricLabelEl = root.querySelector("[data-wb2-metriclabel]");
      const gridG = root.querySelector("[data-wb2-grid]");
      const linesG = root.querySelector("[data-wb2-lines]");
      const hoverG = root.querySelector("[data-wb2-hover]");
      const hoverLine = root.querySelector("[data-wb2-hover-line]");
      const hoverDots = root.querySelector("[data-wb2-hover-dots]");
      const svgEl = root.querySelector("[data-wb2-svg]");
      const svgWrap = root.querySelector("[data-wb2-svg-wrap]");
      const tooltipEl = root.querySelector("[data-wb2-tooltip]");
      const tableTitleEl = root.querySelector("[data-wb2-table-title]");
      const tableUnitEl = root.querySelector("[data-wb2-table-unit]");
      const colIfsEl = root.querySelector("[data-wb2-col-ifs]");
      const tbodyEl = root.querySelector("[data-wb2-tbody]");

      const xToPx = (h) => PAD.l + ((h - 12) / (360 - 12)) * plotW;

      function render() {
        const vObj = wb2Data.variables.find((v) => v.id === curVarId) || wb2Data.variables[0];
        const mInfo = METRIC_INFO[curMetric];
        const seriesMap = vObj[curMetric];

        varNameEl.textContent = vObj.label;
        metricLabelEl.textContent = mInfo.label(vObj.unit);
        tableTitleEl.textContent = `${vObj.short} · ${mInfo.short}`;
        tableUnitEl.textContent = mInfo.unit(vObj.unit);
        colIfsEl.textContent = mInfo.isRel ? "Δ vs. GenCast" : "IFS ENS";

        const vals = [0];
        SERIES_STYLE.forEach((s) => {
          const pts = seriesMap[s.key] || [];
          pts.forEach((p) => {
            if (mInfo.isRel && p[1] < -15) return;
            vals.push(p[1]);
          });
        });

        const minV = Math.min(...vals);
        const maxV = Math.max(...vals);
        const { lo, hi, ticks, step } = niceTicks(minV, maxV, mInfo.isRel);
        const yMin = mInfo.isRel ? Math.min(-2, lo) : lo;
        const yMax = hi;
        const yToPx = (val) => PAD.t + ((yMax - val) / (yMax - yMin)) * plotH;
        currentScale = { vObj, mInfo, seriesMap, yMin, yMax, yToPx };

        const ns = "http://www.w3.org/2000/svg";
        gridG.innerHTML = "";

        ticks.forEach((t) => {
          if (t < yMin || t > yMax) return;
          const py = yToPx(t);
          const isZero = mInfo.isRel && Math.abs(t) < 1e-6;
          const line = document.createElementNS(ns, "line");
          line.setAttribute("x1", String(PAD.l));
          line.setAttribute("x2", String(W - PAD.r));
          line.setAttribute("y1", py.toFixed(1));
          line.setAttribute("y2", py.toFixed(1));
          line.setAttribute("stroke", isZero ? "rgba(255,255,255,0.28)" : "rgba(255,255,255,0.08)");
          line.setAttribute("stroke-width", isZero ? "1.2" : "1");
          if (isZero) line.setAttribute("stroke-dasharray", "4 3");
          gridG.appendChild(line);

          const txt = document.createElementNS(ns, "text");
          txt.setAttribute("x", String(PAD.l - 8));
          txt.setAttribute("y", (py + 3.5).toFixed(1));
          txt.setAttribute("text-anchor", "end");
          txt.setAttribute("class", "wb2-axis-txt");
          if (mInfo.isRel) {
            txt.textContent = `${t > 0 ? "+" : ""}${Math.round(t)}%`;
          } else {
            txt.textContent = step < 0.1 ? t.toFixed(2) : step < 1 ? t.toFixed(1) : String(Math.round(t));
          }
          gridG.appendChild(txt);
        });

        xDayTicks.forEach((d) => {
          const px = xToPx(d * 24);
          const vline = document.createElementNS(ns, "line");
          vline.setAttribute("x1", px.toFixed(1));
          vline.setAttribute("x2", px.toFixed(1));
          vline.setAttribute("y1", String(PAD.t));
          vline.setAttribute("y2", String(H - PAD.b));
          vline.setAttribute("stroke", "rgba(255,255,255,0.045)");
          vline.setAttribute("stroke-width", "1");
          gridG.appendChild(vline);

          const xtxt = document.createElementNS(ns, "text");
          xtxt.setAttribute("x", px.toFixed(1));
          xtxt.setAttribute("y", String(H - PAD.b + 16));
          xtxt.setAttribute("text-anchor", "middle");
          xtxt.setAttribute("class", "wb2-axis-txt");
          xtxt.textContent = `${d}d`;
          gridG.appendChild(xtxt);
        });

        const cap = document.createElementNS(ns, "text");
        cap.setAttribute("x", String(PAD.l + plotW / 2));
        cap.setAttribute("y", String(H - 4));
        cap.setAttribute("text-anchor", "middle");
        cap.setAttribute("class", "wb2-axis-caption");
        cap.textContent = "Forecast lead time (days)";
        gridG.appendChild(cap);

        const clipId = `wb2-clip-${root.id || "main"}`;
        const defs = document.createElementNS(ns, "defs");
        const clip = document.createElementNS(ns, "clipPath");
        clip.setAttribute("id", clipId);
        const rect = document.createElementNS(ns, "rect");
        rect.setAttribute("x", String(PAD.l));
        rect.setAttribute("y", String(PAD.t));
        rect.setAttribute("width", String(plotW));
        rect.setAttribute("height", String(plotH));
        clip.appendChild(rect);
        defs.appendChild(clip);
        gridG.appendChild(defs);

        linesG.innerHTML = "";
        linesG.setAttribute("clip-path", `url(#${clipId})`);
        SERIES_STYLE.forEach((s) => {
          const pts = seriesMap[s.key] || [];
          if (!pts.length) return;
          const dStr = pts
            .map((p, idx) => `${idx === 0 ? "M" : "L"}${xToPx(p[0]).toFixed(1)},${yToPx(p[1]).toFixed(1)}`)
            .join(" ");
          const path = document.createElementNS(ns, "path");
          path.setAttribute("d", dStr);
          path.setAttribute("fill", "none");
          path.setAttribute("stroke", s.color);
          path.setAttribute("stroke-width", String(s.width));
          if (s.dash) path.setAttribute("stroke-dasharray", s.dash);
          if (s.key === "GenCast (oper.) vs ERA5") path.setAttribute("opacity", "0.85");
          linesG.appendChild(path);
        });

        tbodyEl.innerHTML = "";
        const mapByHour = (pts) => {
          const m = new Map();
          (pts || []).forEach((p) => m.set(p[0], p[1]));
          return m;
        };
        const aMap = mapByHour(seriesMap["Astra vs ERA5"]);
        const gMap = mapByHour(seriesMap["GenCast vs ERA5"]);
        const iMap = mapByHour(seriesMap["IFS ENS vs ERA5"]);

        tableHours.forEach((h) => {
          const a = aMap.has(h) ? aMap.get(h) : null;
          const g = gMap.has(h) ? gMap.get(h) : null;
          const ifs = iMap.has(h) ? iMap.get(h) : null;

          const tr = document.createElement("tr");
          const tdLead = document.createElement("td");
          tdLead.textContent = `${h / 24}d`;

          const tdA = document.createElement("td");
          tdA.className = "is-astra";
          tdA.textContent = fmtVal(a, mInfo.isRel, vObj.unit);

          const tdG = document.createElement("td");
          tdG.textContent = fmtVal(g, mInfo.isRel, vObj.unit);

          if (a !== null && g !== null) {
            const aBetter = mInfo.higherBetter ? a >= g - 0.005 : a <= g + 1e-4;
            if (aBetter) tdA.classList.add("is-best");
            else tdG.classList.add("is-best");
          }

          const tdLast = document.createElement("td");
          if (mInfo.isRel) {
            const diff = a !== null && g !== null ? a - g : null;
            tdLast.className = `wb2-delta ${diff !== null && diff >= -0.005 ? "is-pos" : "is-neg"}`;
            tdLast.textContent = diff === null ? "—" : `${diff >= 0 ? "+" : ""}${diff.toFixed(2)} pp`;
          } else {
            tdLast.textContent = fmtVal(ifs, false, vObj.unit);
          }

          tr.append(tdLead, tdA, tdG, tdLast);
          tbodyEl.appendChild(tr);
        });

        hoverG.setAttribute("hidden", "");
        tooltipEl.hidden = true;
      }

      varBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          curVarId = btn.dataset.wb2Var;
          varBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle("is-active", active);
            b.setAttribute("aria-selected", active ? "true" : "false");
          });
          render();
        });
      });

      metricBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          curMetric = btn.dataset.wb2Metric;
          metricBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
          render();
        });
      });

      function onPointerMove(evt) {
        if (!currentScale) return;
        const rect = svgEl.getBoundingClientRect();
        const relX = ((evt.clientX - rect.left) / rect.width) * W;
        if (relX < PAD.l - 6 || relX > W - PAD.r + 6) {
          hoverG.setAttribute("hidden", "");
          tooltipEl.hidden = true;
          return;
        }
        const rawH = 12 + ((relX - PAD.l) / plotW) * (360 - 12);
        const minH = currentScale.vObj.id === "tp24" ? 24 : 12;
        const snapH = Math.max(minH, Math.min(360, Math.round(rawH / 12) * 12));
        const px = xToPx(snapH);

        hoverG.removeAttribute("hidden");
        hoverLine.setAttribute("x1", px.toFixed(1));
        hoverLine.setAttribute("x2", px.toFixed(1));
        hoverDots.innerHTML = "";

        const ns = "http://www.w3.org/2000/svg";
        const rowsHtml = [];
        ["Astra vs ERA5", "GenCast vs ERA5", "GenCast (oper.) vs ERA5", "IFS ENS vs ERA5"].forEach((k) => {
          const st = SERIES_STYLE.find((s) => s.key === k);
          const pts = currentScale.seriesMap[k] || [];
          const pt = pts.find((p) => p[0] === snapH);
          if (!pt) return;
          const py = currentScale.yToPx(pt[1]);
          if (py >= PAD.t && py <= H - PAD.b) {
            const c = document.createElementNS(ns, "circle");
            c.setAttribute("cx", px.toFixed(1));
            c.setAttribute("cy", py.toFixed(1));
            c.setAttribute("r", k === "Astra vs ERA5" ? "4.2" : "3.2");
            c.setAttribute("fill", st.color);
            c.setAttribute("stroke", "#101218");
            c.setAttribute("stroke-width", "1.5");
            hoverDots.appendChild(c);
          }
          rowsHtml.push(
            `<div class="wb2-tt-row"><span class="wb2-tt-name"><i style="background:${st.color}"></i>${st.label}</span><strong>${fmtVal(pt[1], currentScale.mInfo.isRel, currentScale.vObj.unit)}</strong></div>`
          );
        });

        const daysLabel = (snapH / 24).toFixed(snapH % 24 === 0 ? 0 : 1);
        tooltipEl.innerHTML = `<div class="wb2-tt-head">Lead ${daysLabel}d (${snapH}h)</div>${rowsHtml.join("")}`;
        tooltipEl.hidden = false;

        const wrapW = svgWrap.clientWidth;
        const pxCss = (px / W) * wrapW;
        const placeLeft = px > W * 0.58;
        tooltipEl.style.left = placeLeft ? `${Math.max(8, pxCss - 196)}px` : `${Math.min(wrapW - 196, pxCss + 14)}px`;
      }

      svgEl.addEventListener("pointermove", onPointerMove);
      svgEl.addEventListener("pointerleave", () => {
        hoverG.setAttribute("hidden", "");
        tooltipEl.hidden = true;
      });

      render();
    });
  })();
</script>
