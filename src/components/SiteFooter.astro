---
import { site } from "../config/site";
---
<footer class="site-footer container">
  <div class="footer-main">
    <div class="footer-email-group">
      <button
        type="button"
        class="dm-meta-link dm-email-toggle footer-email-toggle"
        aria-expanded="false"
        aria-controls="footer-email-drawer"
        data-email-toggle
      >
        Email <span class="dm-chevron" aria-hidden="true">›</span>
      </button>
      <div class="footer-email-drawer" id="footer-email-drawer" hidden>
        <span class="dm-email-item">
          <span class="dm-email-label">Institutional</span>
          <a class="dm-email-addr" href={`mailto:${site.emailInstitutional}`}>{site.emailInstitutional}</a>
        </span>
        <span class="dm-email-sep" aria-hidden="true">·</span>
        <span class="dm-email-item">
          <span class="dm-email-label">Permanent</span>
          <a class="dm-email-addr" href={`mailto:${site.emailPermanent}`}>{site.emailPermanent}</a>
        </span>
      </div>
    </div>
    <nav class="footer-links" aria-label="External profiles">
      {site.externalLinks.map(({ label, href }) => (
        <a href={href}>{label === "github" ? "GitHub" : "ORCID"}</a>
      ))}
    </nav>
  </div>
  <p class="footer-bottom">© {new Date().getUTCFullYear()} {site.name}</p>
</footer>
