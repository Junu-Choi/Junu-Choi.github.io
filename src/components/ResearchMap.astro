---
import { researchAreas, researchWork } from "../data/research";
---
<section class="research-section" id="research" aria-labelledby="research-title" data-research-map>
  <div class="dm-section-head">
    <div class="dm-section-titles">
      <h2 id="research-title" class="dm-section-title">Research Interests</h2>
      <p class="dm-section-subtitle">Connecting mathematical foundations in transport and diffusion with scientific discovery.</p>
    </div>
    <button class="dm-pill-btn all-research" type="button" aria-controls="related-work" aria-pressed="false" aria-expanded="false" data-all-research hidden>
      Explore all ({String(researchWork.length).padStart(2, "0")}) <span aria-hidden="true">+</span>
    </button>
  </div>

  <div class="research-map" data-map-canvas>
    <ul class="research-areas" id="research-topics">
      {researchAreas.map((area) => (
        <li>
          <button class="research-area" type="button" data-area={area.id} data-work={area.work.join(" ")} data-label={area.label}
            aria-labelledby={`area-${area.id}`} aria-describedby={`area-${area.id}-description`} aria-controls="related-work" aria-expanded="false" aria-pressed="false" disabled>
            <span class="dark-domain-copy">
              <span class="area-heading">
                <span id={`area-${area.id}`} class="area-name">{area.name}</span>
              </span>
              <span class="area-description" id={`area-${area.id}-description`}>{area.description}</span>
            </span>
            <span class="dark-domain-footer">
              <span class="domain-action-pill">
                <span class="domain-action-circle" aria-hidden="true">
                  <span class="area-toggle">+</span>
                </span>
                <span class="domain-action-label">Explore ({area.work.length})</span>
              </span>
              <span class="dark-domain-art" aria-hidden="true">
                {area.id === "generative" && (
                  <svg width="156" height="72" viewBox="0 0 180 80" fill="none">
                    <path d="M10 65 C 60 65, 90 15, 170 15" stroke="#8AB4F8" stroke-width="2" stroke-opacity="0.8"/>
                    <path d="M10 65 C 70 45, 100 40, 170 35" stroke="#8AB4F8" stroke-width="1.2" stroke-opacity="0.4" stroke-dasharray="3 3"/>
                    <path d="M10 65 C 50 25, 110 60, 170 55" stroke="#C58AF9" stroke-width="1.5" stroke-opacity="0.6"/>
                    <circle cx="10" cy="65" r="4" fill="#8AB4F8"/>
                    <circle cx="170" cy="15" r="4" fill="#8AB4F8"/>
                  </svg>
                )}
                {area.id === "inference" && (
                  <svg width="156" height="72" viewBox="0 0 180 80" fill="none">
                    <rect x="68" y="12" width="96" height="56" rx="12" stroke="#8AB4F8" stroke-width="1.2" stroke-opacity="0.4"/>
                    <circle cx="100" cy="40" r="13" stroke="#F28B82" stroke-width="1.6" stroke-opacity="0.65"/>
                    <circle cx="132" cy="40" r="13" stroke="#8AB4F8" stroke-width="1.6" stroke-opacity="0.8"/>
                  </svg>
                )}
                {area.id === "scientific-ai" && (
                  <svg width="156" height="72" viewBox="0 0 180 80" fill="none">
                    <circle cx="130" cy="40" r="32" stroke="#8AB4F8" stroke-width="1.5" stroke-opacity="0.65"/>
                    <ellipse cx="130" cy="40" rx="32" ry="13" stroke="#8AB4F8" stroke-width="1.1" stroke-opacity="0.38"/>
                    <ellipse cx="130" cy="40" rx="15" ry="32" stroke="#81C995" stroke-width="1.2" stroke-opacity="0.5"/>
                  </svg>
                )}
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <section class="related-work" id="related-work" aria-labelledby="work-title" hidden>
      <div class="related-work-bar">
        <div class="related-work-title-group">
          <h3 id="work-title" class="related-work-heading" data-work-context>Related research &amp; projects</h3>
        </div>
        <button class="dm-pill-btn related-work-close" type="button" data-close-research>
          Close <span aria-hidden="true">×</span>
        </button>
      </div>
      <ul class="work-grid" data-work-grid>
        {researchWork.map((work) => (
          <li class="work-card" id={`work-${work.id}`} data-research-work={work.id}>
            <p class="work-meta">
              <span class="work-place">{work.place}</span>
              {work.forthcoming && <span>{work.status ?? "To be published"}</span>}
            </p>
            <h4><a href={work.href}>{work.title}</a></h4>
            <p class="work-description">{work.description}</p>
            {work.links && (
              <div class="dm-meta-row work-links">
                {work.links.map((link) => (
                  <a class="dm-meta-link" href={link.href}>
                    {link.label} <span class="dm-chevron" aria-hidden="true">›</span>
                  </a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-work-status></p>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-research-map]").forEach((section) => {
    const areas = [...section.querySelectorAll<HTMLButtonElement>("[data-area]")];
    const entries = [...section.querySelectorAll<HTMLElement>("[data-research-work]")];
    const panel = section.querySelector<HTMLElement>(".related-work")!;
    const grid = section.querySelector<HTMLElement>("[data-work-grid]")!;
    const context = section.querySelector<HTMLElement>("[data-work-context]");
    const status = section.querySelector<HTMLElement>("[data-work-status]");
    const allButton = section.querySelector<HTMLButtonElement>("[data-all-research]")!;
    const closeButton = section.querySelector<HTMLButtonElement>("[data-close-research]");
    let selected = "compact";

    function select(mode: string, announce = true) {
      selected = mode;
      section.dataset.selected = mode;
      const area = areas.find((entry) => entry.dataset.area === mode);
      const related = new Set((area?.dataset.work ?? "").split(" "));
      let count = 0;
      areas.forEach((entry) => {
        const active = entry === area;
        entry.setAttribute("aria-pressed", String(active));
        entry.setAttribute("aria-expanded", String(active));
        entry.querySelector(".area-toggle")!.textContent = active ? "×" : "+";
      });
      entries.forEach((entry) => {
        entry.hidden = mode !== "all" && !related.has(entry.dataset.researchWork!);
        if (!entry.hidden) count++;
      });
      panel.hidden = count === 0;
      grid.dataset.count = String(count);
      grid.style.setProperty("--work-columns", String(Math.min(count || 1, 3)));
      allButton.setAttribute("aria-pressed", String(mode === "all"));
      allButton.setAttribute("aria-expanded", String(mode === "all"));
      allButton.querySelector("span")!.textContent = mode === "all" ? "×" : "+";
      const label = mode === "all" ? "All Research & Earlier Projects" : area?.dataset.label ?? "";
      if (context) context.textContent = `${label} · ${count} ${count === 1 ? "project" : "projects"}`;
      if (announce && status) status.textContent = count ? `${label}: ${count} related ${count === 1 ? "project" : "projects"} shown below.` : "Related work closed.";
    }

    areas.forEach((area) => {
      area.disabled = false;
      area.addEventListener("click", () => select(selected === area.dataset.area ? "compact" : area.dataset.area!));
    });
    allButton.hidden = false;
    allButton.addEventListener("click", () => select(selected === "all" ? "compact" : "all"));
    closeButton?.addEventListener("click", () => select("compact"));
    section.dataset.enhanced = "true";
    select("compact", false);
  });
</script>
