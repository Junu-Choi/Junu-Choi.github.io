---
import { site } from "../config/site";

interface Props { activeNav?: string; }
const { activeNav } = Astro.props;
---
<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
        <span>{site.name}</span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        {site.nav.map(({ label, href }) => (
          <a href={href} aria-current={activeNav === label ? "page" : undefined}>
            {label === "about" ? "Overview" : label === "cv" ? "CV" : label.charAt(0).toUpperCase() + label.slice(1)}
          </a>
        ))}
      </nav>
    </div>
    <div class="header-right">
      <a class="dm-pill-btn" href="https://github.com/Junu-Choi">GitHub</a>
      <a class="dm-pill-btn" href={`mailto:${site.email}`}>Contact</a>
    </div>
  </div>
</header>
