---
// Original illustrative artwork using the PTM Figure 2 palette.
// These contours are a design motif, not a visualization of research results.
function contour(cx: number, cy: number, rx: number, ry: number, scale = 1) {
  const points = Array.from({ length: 120 }, (_, i) => {
    const a = (i / 120) * Math.PI * 2;
    const warp = 1 + 0.14 * Math.cos(3 * a) + 0.07 * Math.sin(2 * a);
    return `${(cx + rx * scale * warp * Math.cos(a)).toFixed(2)},${(cy + ry * scale * warp * Math.sin(a)).toFixed(2)}`;
  });
  return `M${points.join("L")}Z`;
}
const levels = [1, 0.82, 0.64, 0.46, 0.28];
const colors = ["#e3eef7", "#c5dced", "#9fc4de", "#75a9cd", "#347fb3"];
const lines = Array.from({ length: 11 }, (_, i) => i);
---
<figure class="transport-study">
  <div class="study-topline"><span>Geometry in motion</span><span aria-hidden="true">[ 01 — 02 ]</span></div>
  <svg viewBox="0 0 580 450" class="study-svg" fill="none" role="img" aria-labelledby="study-title study-desc">
    <title id="study-title">An illustration of distribution geometry</title>
    <desc id="study-desc">Layered blue density contours and fine mesh lines connect along teal curved paths. The slider changes the shape of the upper distribution. This is an illustrative design, not experimental data.</desc>
    <defs>
      <pattern id="study-grid" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="0.65" fill="#b5c5d0"/></pattern>
      <clipPath id="contour-clip"><path d={contour(0, 0, 99, 65)}/></clipPath>
      <marker id="teal-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M1 1L8 5L1 9" stroke="#238a83" stroke-width="1.3" fill="none"/></marker>
    </defs>
    <rect x="20" y="20" width="540" height="410" fill="url(#study-grid)" opacity="0.52"/>
    <g stroke="#d6e0e5" stroke-width="0.8">
      <path d="M24 32H48M36 20V44M532 32H556M544 20V44M24 418H48M36 406V430M532 418H556M544 406V430"/>
    </g>
    <g class="study-guides" stroke="#30363e" stroke-opacity="0.13" stroke-width="1">
      {lines.map((i) => <path d={`M${330 + i * 11} ${95 + i * 4} C${440 - i * 10} ${198 + i * 2} ${170 + i * 8} ${242 + i * 4} ${150 + i * 9} ${318 + i * 1.9}`}/>)}
    </g>
    <path d="M146 293C96 236 186 56 269 95" stroke="#238a83" stroke-width="1.8" marker-end="url(#teal-arrow)"/>
    <path d="M152 292C114 224 194 70 269 101" stroke="#238a83" stroke-width="0.8" stroke-opacity="0.3"/>
    <path d="M456 163C492 257 380 353 319 341" stroke="#238a83" stroke-width="1.8" marker-end="url(#teal-arrow)"/>
    <path d="M462 162C508 262 385 365 318 347" stroke="#238a83" stroke-width="0.8" stroke-opacity="0.3"/>
    <g transform="translate(361 133) rotate(-27)">
      <g class="study-shape" transform="scale(1 1)">
        {levels.map((s, i) => <path d={contour(0, 0, 99, 65, s)} fill={colors[i]} stroke="#2878b5" stroke-opacity={i === 0 ? ".72" : ".14"} stroke-width="1"/>)}
        <g clip-path="url(#contour-clip)" stroke="#30363e" stroke-opacity="0.3" stroke-width="0.7">
          {lines.map((i) => <><path d={`M${-105 + i * 21} -90Q${-145 + i * 25} 0 ${-105 + i * 21} 90`}/><path d={`M-130 ${-70 + i * 14}Q0 ${-102 + i * 20} 130 ${-70 + i * 14}`}/></>)}
        </g>
      </g>
      <path d={contour(-5, 0, 106, 70)} stroke="#30363e" stroke-width="1.3" stroke-dasharray="5 4"/>
      <path d="M-43-29L-26-34L-23-21L-40-16Z" fill="#c16a43" fill-opacity="0.7"/>
    </g>
    <g transform="translate(226 330) rotate(-17)">
      {levels.map((s, i) => <path d={contour(0, 0, 115, 33, s)} fill={colors[i]} stroke="#2878b5" stroke-opacity={i === 0 ? ".72" : ".1"} stroke-width="1"/>)}
      <path d={contour(-10, -2, 130, 38)} stroke="#30363e" stroke-width="1.3" stroke-dasharray="5 4"/>
      <path d={contour(0, 0, 65, 17)} stroke="#30363e" stroke-width="0.8" stroke-dasharray="4 4"/>
    </g>
    <g class="study-labels" fill="#586775">
      <text x="461" y="79">ρ₀</text><text x="345" y="383">ρ₁</text>
      <text x="122" y="168" transform="rotate(-62 122 168)" class="study-path-label">transport</text>
      <text x="491" y="296" transform="rotate(-58 491 296)" class="study-path-label">geometry</text>
    </g>
    <circle cx="151" cy="300" r="3.2" fill="#238a83"/>
    <circle cx="453" cy="166" r="3.2" fill="#238a83"/>
  </svg>
  <div class="study-controls" hidden>
    <label for="study-time">Deform the distribution</label>
    <input id="study-time" type="range" min="0" max="100" value="50" aria-valuetext="Shape parameter 0.50"/>
    <output for="study-time">τ = 0.50</output>
  </div>
  <figcaption><span class="study-legend"><i aria-hidden="true"></i>Distributions &amp; the paths between them</span><span>Illustration</span></figcaption>
</figure>

<script>
  const study = document.querySelector<HTMLElement>(".transport-study");
  const slider = study?.querySelector<HTMLInputElement>("input");
  const shape = study?.querySelector<SVGGElement>(".study-shape");
  const output = study?.querySelector("output");
  const controls = study?.querySelector<HTMLElement>(".study-controls");
  if (slider && shape && output && controls) {
    controls.hidden = false;
    slider.addEventListener("input", () => {
      const t = Number(slider.value) / 100;
      shape.setAttribute("transform", `rotate(${(t - 0.5) * 35}) scale(${0.7 + t * 0.6} ${1.3 - t * 0.6})`);
      output.textContent = `τ = ${t.toFixed(2)}`;
      slider.setAttribute("aria-valuetext", `Shape parameter ${t.toFixed(2)}`);
    });
  }
</script>
