---
import { ptmManuscript } from "../data/manuscripts";
---
<article class="publication-preview" id={ptmManuscript.id} aria-labelledby="ptm-title">
  <div class="publication-banner publication-banner--stacked">
    <header class="preview-heading">
      <h2 id="ptm-title">{ptmManuscript.title}</h2>
      <p class="preview-description">{ptmManuscript.description}</p>
      <div class="dm-meta-row" style="margin-top: 18px;">
        <span>2026</span>
        <span>Junu Choi, Youngjoon Hong · {ptmManuscript.status}</span>
      </div>
    </header>
    <figure class="preview-figure preview-figure--wide">
      <a href="/figures/ptm/benchmark-overview.webp" aria-label="View PTM image restoration and InverseBench results at full size">
        <img src="/figures/ptm/benchmark-overview.webp" width="2400" height="1170" loading="eager" decoding="async"
          alt="Posterior Transport Matching empirical results: (a) image restoration on ImageNet and FFHQ with 48x48 zoom insets and PSNR gains up to +5.83 dB over SITCOM and DAPS, and (b) InverseBench scientific inverse problems across black-hole interferometry, inverse scattering, multi-coil knee MRI, and acoustic full waveform inversion."/>
      </a>
      <figcaption>Image restoration with 48×48 zoom insets (a; ImageNet &amp; FFHQ 256×256, PSNR in dB) and scientific inverse problems on InverseBench (b; PTM vs. training-free diffusion baselines).</figcaption>
    </figure>
  </div>
</article>
