---
import { ptmManuscript } from "../data/manuscripts";
---
<article class="publication-preview" id={ptmManuscript.id} aria-labelledby="ptm-title">
  <div class="publication-banner">
    <header class="preview-heading">
      <p class="eyebrow"><span class="preview-number">01</span> Manuscript preview</p>
      <h2 id="ptm-title">{ptmManuscript.title}</h2>
      <p class="preview-description">{ptmManuscript.description}</p>
      <p class="preview-availability">{ptmManuscript.availability}</p>
    </header>
    <figure class="preview-figure">
      <a href="/figures/ptm/figure-2.svg" aria-label="View Figure 2 at full size">
        <img src="/figures/ptm/figure-2.svg" width="1875" height="734" loading="eager" decoding="async"
          alt="Figure 2: numerical transport maps alternate with rematching. Blue current laws are compared with dashed required input laws and their common posterior target."/>
      </a>
      <figcaption>Figure 2. Rematching supplies a compatible input law.</figcaption>
    </figure>
  </div>

  <details class="geometry-figure" data-geometry-figure>
    <summary class="geometry-summary" id="geometry-title">Geometry in motion</summary>
    <div class="geometry-heading">
      <p>A map changes volume. An observation changes the shape of uncertainty.</p>
      <button class="motion-toggle" type="button" hidden data-motion-toggle>Play animation</button>
    </div>
    <div class="geometry-panels">
      <figure>
        <h3><span aria-hidden="true">a.</span> Local volume</h3>
        <img
          src="/figures/ptm/volume-still.png"
          data-still-src="/figures/ptm/volume-still.png"
          data-animation-src="/figures/ptm/volume.gif"
          width="640" height="460" loading="lazy" decoding="async"
          alt="A smooth map deforms a square grid. Two initially equal cells change area by factors of 0.48 and 1.35 at the endpoint."
        />
        <figcaption>Equal source cells acquire different areas under a smooth transport map. The counters track each cell’s area relative to its starting value.</figcaption>
      </figure>
      <figure>
        <h3><span aria-hidden="true">b.</span> Conditioning</h3>
        <img
          src="/figures/ptm/conditioning-still.png"
          data-still-src="/figures/ptm/conditioning-still.png"
          data-animation-src="/figures/ptm/conditioning.gif"
          width="640" height="460" loading="lazy" decoding="async"
          alt="As observation precision increases, the rust Gaussian kernel narrows along the observed direction. Its variance falls from 0.8 to 0.073, while the unobserved variance stays at 0.8. Blue contours show the prior convolved with that kernel."
        />
        <figcaption>Stronger conditioning narrows the <span class="kernel-key">Gaussian kernel</span> along the observed direction. Blue contours show the same prior convolved with that kernel.</figcaption>
      </figure>
    </div>
    <p class="geometry-note">Illustrative 2D geometry. The blue contours describe a smoothed prior, rather than posterior marginals.</p>
  </details>
</article>

<script>
  document.querySelectorAll<HTMLDetailsElement>("[data-geometry-figure]").forEach((figure) => {
    const button = figure.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    const images = figure.querySelectorAll<HTMLImageElement>("[data-animation-src]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (!button) return;

    let wantsMotion = !reducedMotion.matches;
    function updatePlayback() {
      const playing = figure.open && wantsMotion;
      images.forEach((image) => {
        const source = playing ? image.dataset.animationSrc : image.dataset.stillSrc;
        if (source && image.getAttribute("src") !== source) image.src = source;
      });
      button!.textContent = playing ? "Show stills" : "Play animation";
      figure.dataset.motionState = playing ? "playing" : "still";
    }

    button.hidden = false;
    updatePlayback();
    figure.addEventListener("toggle", updatePlayback);
    button.addEventListener("click", () => {
      wantsMotion = !wantsMotion;
      updatePlayback();
    });
    reducedMotion.addEventListener("change", (event) => {
      wantsMotion = !event.matches;
      updatePlayback();
    });
  });
</script>
