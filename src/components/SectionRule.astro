---
interface Props {
  label: string;
  index?: string;
  id?: string;
  href?: string;
  linkLabel?: string;
}
const { label, index, id, href, linkLabel } = Astro.props;
---
<div class="section-heading">
  <h2 id={id}>{index && <span class="section-index" aria-hidden="true">{index} /</span>}{label}</h2>
  {href && <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</div>
